### MCP initialize with OIDC token
POST {{host}}/mcp
Authorization: Bearer {{$auth.token("oidc-paperless")}}
Accept: application/json, text/event-stream
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2025-11-25",
    "capabilities": {},
    "clientInfo": {
      "name": "intellij-http-client",
      "version": "1"
    }
  }
}

###
POST {{host}}/mcp
Authorization: Bearer {{$auth.token("oidc-paperless")}}
Mcp-Session-Id: {{mcpSessionId}}
Accept: application/json, text/event-stream
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}
